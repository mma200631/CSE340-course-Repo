<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Assign Categories to "<%= projectDetails.title %>"</h2>

    <form action="/assign-categories/<%= projectDetails.project_id %>" method="POST">

        <% categories.forEach(category => { %>
            <div class="form-group">
                <label>
                    <input
                        type="checkbox"
                        name="categoryIds"
                        value="<%= category.category_id %>"

                    <%= assignedCategoryIds.includes(category.category_id) ? 'checked' : '' %>
                    >

                    <%= category.category_name %>
                </label>
            </div>
        <% }) %>

        <button type="submit">Save Categories</button>

    </form>
</main>

<%- include('partials/footer') %>