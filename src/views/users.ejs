<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p>Welcome to the users page!</p>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                <% user.forEach((user) => { %>
                    <tr>
                        <td><%= user.name %></td>
                        <td><%= user.email %></td>
                        <td><%= user.role_name %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>